[Unit]
Description=Polymarket read-only market and orderbook collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/polymarket_market_collector
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/polymarket_market_collector/.venv/bin/python collector.py --config config.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
